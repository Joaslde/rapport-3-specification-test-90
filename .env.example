# LE TEST DES 90 JOURS — variables d'environnement
#
# Copier ce fichier en .env et renseigner les valeurs reelles.
# Le .env n'est JAMAIS versionne (regle S3 de docs/securite.md).
#
# ATTENTION : tout ce qui est prefixe VITE_ finit dans le bundle public.
# Ne jamais y placer un secret.

# ---------------------------------------------------------------
# FRONT — expose au navigateur (protege par les politiques RLS)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# ---------------------------------------------------------------
# SERVEUR — Edge Functions uniquement
# A definir via : supabase secrets set NOM=valeur
# NE JAMAIS prefixer VITE_ — ces valeurs ne doivent pas atteindre le client.
# ---------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=rapport@votredomaine.com
